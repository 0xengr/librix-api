meta {
  name: Delete User
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/v1/users/{{userId}}
  body: none
  auth: none
}

vars:pre-request {
  userId: 3
}

assert {
  res.status: eq 204
}

docs {
  Deletes a user. 204 on success, 404 when it does not exist.
  Note: borrowed_books rows are deleted by ON DELETE CASCADE.
}
