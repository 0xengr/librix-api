meta {
  name: Create Book
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/books
  body: json
  auth: none
}

body:json {
  {
    "title": "The Go Programming Language",
    "author": "Alan A. A. Donovan and Brian W. Kernighan",
    "description": "A hands-on guide to writing clear, idiomatic Go.",
    "year_of_publication": 2015
  }
}

assert {
  res.status: eq 201
}

docs {
  Creates a book. `title` and `author` are required.
  `description` and `year_of_publication` are optional; omit them or send
  "" / 0 to store NULL.

  New books are available by default.
}
